{
  "name": "ppc-bench",
  "private": true,
  "version": "0.1.0",
  "description": "PowerPC assembly test bench with deep debugging — Tauri + SolidJS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace apps/desktop run tauri:dev",
    "build:desktop": "npm --workspace apps/desktop run tauri:build",
    "dev:web": "npm --workspace apps/desktop run dev",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.8"
  }
}
